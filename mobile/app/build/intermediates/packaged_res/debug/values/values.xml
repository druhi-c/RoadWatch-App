<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_dark_slate">#12151A</color>
    <color name="card_surface">#1E232A</color>
    <color name="coral_red">#FC5C65</color>
    <color name="mint_green">#25C19A</color>
    <color name="text_light">#FFFFFF</color>
    <color name="text_muted">#888888</color>
    <color name="text_primary">#FFFFFF</color>
    <style name="Circular" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Theme.RoadWatch" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mint_green</item>
        <item name="colorOnPrimary">@color/text_light</item>
        <item name="colorSecondary">@color/coral_red</item>
        <item name="colorOnSecondary">@color/text_light</item>
        <item name="android:colorBackground">@color/bg_dark_slate</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_light</item>
        <item name="colorOnBackground">@color/text_light</item>
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>
</resources>